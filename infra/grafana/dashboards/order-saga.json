    {
      "type": "timeseries",
      "title": "Saga outcomes per minute",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "cause=none for confirmed orders; otherwise why the order was cancelled",
      "gridPos": {
        "h": 8,
