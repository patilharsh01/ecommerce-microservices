# Copy to .env to override the development defaults used by docker-compose.yml.
# None of these defaults are fit for anything but a laptop.

# Bootstrap administrator (self-registration only ever creates customers)
ADMIN_EMAIL=admin@shop.local
ADMIN_PASSWORD=admin12345

# Postgres superuser, plus one login per service database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
AUTH_DB_PASSWORD=auth_service
PRODUCT_DB_PASSWORD=product_service
ORDER_DB_PASSWORD=order_service
PAYMENT_DB_PASSWORD=payment_service
NOTIFICATION_DB_PASSWORD=notification_service

# Saga behaviour
ORDER_SAGA_STEP_TIMEOUT=30s
PAYMENT_APPROVAL_LIMIT=50000

GRAFANA_ADMIN_PASSWORD=admin
